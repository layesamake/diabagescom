# DIABA GESCOM — modèle de configuration.
# Ne jamais versionner de vraie valeur secrète. Sur les serveurs, ce fichier est
# matérialisé dans /opt/diaba/<env>/.env (chmod 600) depuis le gestionnaire de secrets.

APP_NAME="DIABA GESCOM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

BCRYPT_ROUNDS=12

# Logs JSON sur stderr (collectés par Docker). "stack" en local pour lecture humaine.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=diaba
DB_USERNAME=diaba
DB_PASSWORD=
DB_TEST_DATABASE=diaba_testing

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=diaba_cache_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_PREFIX=diaba_

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@diaba.cloud"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Facturation SaaS (EPIC-08) — aucun paiement réel n'est activé.
# Bac à sable : simulation signée du prestataire (désactivé par défaut en production).
BILLING_SANDBOX_ENABLED=
# Secret HMAC du bac à sable : générer une valeur aléatoire locale, jamais commitée.
BILLING_SANDBOX_SECRET=
# Coordonnées de virement affichées aux clients (à fournir par le propriétaire).
BILLING_TRANSFER_INSTRUCTIONS=

# Sauvegardes vers Google Drive (Google Cloud Console → Identifiants OAuth, application Web).
# Le secret se saisit uniquement sur le serveur.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# Page d'accueil publique : WhatsApp commercial (221XXXXXXXXX), e-mail de contact,
# indexation Google (true en production uniquement).
DIABA_SALES_WHATSAPP=
DIABA_CONTACT_EMAIL=
DIABA_SEARCH_INDEXING=false
